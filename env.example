FLASK_APP=app:create_app
FLASK_ENV=production
DEBUG=False

# Security Keys — Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GENERATE-A-RANDOM-64-CHAR-HEX-STRING
# Key for encrypting sensitive card data — also generate with secrets.token_hex(32)
CARD_ENCRYPTION_KEY=GENERATE-A-RANDOM-64-CHAR-HEX-STRING

# Database (PostgreSQL is Required for Production)
# Format: postgresql+psycopg2://username:password@hostname:port/database_name
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/garage_simple

# Server Settings
HOST=0.0.0.0
PORT=5000
BASE_URL=https://your-domain.com

# Currency Settings
DEFAULT_CURRENCY=AED
CURRENCY_API_PROVIDER=exchangerate-api
CURRENCY_API_KEY=your-currency-api-key
CURRENCY_API_URL=https://v6.exchangerate-api.com/v6/{api_key}/latest/{base}
CURRENCY_CACHE_TIMEOUT=3600

# Company Information
COMPANY_NAME=Your Company Name
COMPANY_NAME_AR=اسم شركتك
COMPANY_ADDRESS=Your Address
COMPANY_PHONE=+971XXXXXXXXX
COMPANY_WHATSAPP=XXXXXXXXXXX
COMPANY_EMAIL=your-email@domain.com
COMPANY_WEBSITE=https://your-domain.com
COMPANY_TAX_NUMBER=

# Developer Information
DEVELOPER_NAME=Developer Name
DEVELOPER_COMPANY=Company Name
DEVELOPER_WEBSITE=https://developer-domain.com
DEVELOPER_PHONE=+971XXXXXXXXX
DEVELOPER_EMAIL=developer@email.com

# Master Owner Account — Generate password with: python -c "import secrets; print(secrets.token_urlsafe(16))"
OWNER_USERNAME=owner
OWNER_PASSWORD=GENERATE-A-STRONG-PASSWORD-MIN-10-CHARS
OWNER_EMAIL=owner@your-domain.com

# Redis (Cache & Celery)
REDIS_URL=redis://localhost:6379/0
CACHE_TYPE=redis

# Mail Settings (Gmail Example)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# WhatsApp Integration
WHATSAPP_ENABLED=False
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER=

# NOWPayments Integration
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=your-ipn-secret

# Security Settings
MAX_LOGIN_ATTEMPTS=5
LOGIN_BLOCK_DURATION_MINUTES=15

# UI Settings
ITEMS_PER_PAGE=20
LOG_LEVEL=INFO

# Master Key (daily-rotating Owner key) - Optional override of the built-in seed
# Daily key format at login: <seed>@YYYY@MM@DD   e.g. Azad@1983@2026@08@25
# MASTER_KEY_SEED=Azad@1983
