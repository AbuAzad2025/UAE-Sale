FLASK_APP=app:create_app
FLASK_ENV=production
DEBUG=False

# Security Keys
# Generate a long random string for production
SECRET_KEY=change-this-to-random-secret-key-in-production-VERY-LONG-AND-RANDOM
# Key for encrypting sensitive card data
CARD_ENCRYPTION_KEY=change-this-to-another-random-key

# Database (PostgreSQL is Required for Production)
# Format: postgresql://username:password@hostname:port/database_name
DATABASE_URL=postgresql://postgres:123@localhost:5432/garage_simple

# Server Settings
HOST=0.0.0.0
PORT=8080

# Currency Settings
DEFAULT_CURRENCY=AED
CURRENCY_API_PROVIDER=exchangerate-api
CURRENCY_API_KEY=
CURRENCY_API_URL=https://v6.exchangerate-api.com/v6/{api_key}/latest/{base}
CURRENCY_CACHE_TIMEOUT=3600

# Company Information
COMPANY_NAME=Nasr Auto Parts
COMPANY_NAME_AR=شركة نصر لقطع الغيار
COMPANY_ADDRESS=أبو ظبي - الإمارات العربية المتحدة
COMPANY_PHONE=+970592800646
COMPANY_WHATSAPP=970592800646
COMPANY_EMAIL=rafideen.ahmadghannam@gmail.com
COMPANY_WEBSITE=
COMPANY_TAX_NUMBER=

# Developer Information
DEVELOPER_NAME=م. أحمد غنام
DEVELOPER_COMPANY=شركة أزاد للأنظمة الذكية
DEVELOPER_WEBSITE=
DEVELOPER_PHONE=+970592800646
DEVELOPER_EMAIL=rafideen.ahmadghannam@gmail.com

# Master Owner Account (Will be created if not exists)
OWNER_USERNAME=Naser
OWNER_PASSWORD=REDACTED-PASSWORD
OWNER_EMAIL=rafideen.ahmadghannam@gmail.com

# Redis (Cache & Celery)
REDIS_URL=redis://localhost:6379/0
CACHE_TYPE=redis

# Mail Settings (Gmail Example)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# WhatsApp Integration
WHATSAPP_ENABLED=False
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER=

# Security Settings
MAX_LOGIN_ATTEMPTS=5
LOGIN_BLOCK_DURATION_MINUTES=15

# UI Settings
ITEMS_PER_PAGE=20
LOG_LEVEL=INFO
