# ─────────────────────────────────────────────────────────────────────────────
# Environment template - copy to .env and fill in.
#   cp .env.example .env
#
# .env is gitignored and must never be committed. On PythonAnywhere set these
# as environment variables in the Web tab instead of shipping a .env file.
# Every value below is the app's own default, so an empty .env is a valid
# development configuration.
# ─────────────────────────────────────────────────────────────────────────────

# ── Mode ────────────────────────────────────────────────────────────────────
# "production" refuses to start on SQLite and turns off debug output.
APP_ENV=production
DEBUG=false
# The app binds 0.0.0.0 by default; PythonAnywhere's proxy handles TLS.
HOST=0.0.0.0
PORT=5000
# Set when the app is served under a sub-path (e.g. /sale). url_for() then
# respects the prefix and links stay relative to the mount point.
APPLICATION_ROOT=/

# ── Database (REQUIRED in production) ───────────────────────────────────────
# PostgreSQL. The postgres:// and postgresql:// schemes are rewritten to
# postgresql+psycopg2:// automatically.
#
# PythonAnywhere gives you a database named <user>_<dbname> and a password you
# set yourself. The local PostgreSQL server's own user is NOT used on
# PythonAnywhere - use the credentials from the "Databases" tab.
#
#   DATABASE_URL=postgresql://azaduser:YOUR_PASSWORD@azaduser:5432/azaduser
#
# On PythonAnywhere's own host use the socket form, which is faster and is
# what their docs recommend:
#   DATABASE_URL=postgresql://azaduser:YOUR_PASSWORD@localhost/azaduser?host=/var/run/postgresql
DATABASE_URL=

# ── Secrets (REQUIRED in production) ────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
# If SECRET_KEY is empty the app generates one and writes it to
# instance/secret_key, which works but means every deploy invalidates the
# previous sessions if the file is lost.
SECRET_KEY=

# Used to encrypt stored card data (payment vault). Must be 32 bytes; the
# app derives a valid key from any non-empty value.
CARD_ENCRYPTION_KEY=

# Password of the platform owner account, created on first boot if it does
# not exist. 16+ characters. Set it explicitly in production - otherwise the
# account is created with a random password that nobody knows.
OWNER_PASSWORD=

# Optional seed for the master key. Leave empty to generate one.
MASTER_KEY_SEED=

# ── Cache ───────────────────────────────────────────────────────────────────
# SimpleCache is the default: an in-process dictionary, no external service
# needed. Use Redis only if you actually run a Redis instance, and then also
# set REDIS_URL / CACHE_REDIS_URL.
CACHE_TYPE=flask_caching.backends.SimpleCache
CACHE_DEFAULT_TIMEOUT=300
CACHE_KEY_PREFIX=azad_erp

# Only needed for the optional Celery worker and for a Redis cache.
REDIS_URL=redis://localhost:6379/0
CACHE_REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ── Rate limiting ───────────────────────────────────────────────────────────
# "memory://" keeps the limiter in-process, which works on a single server
# without Redis. A shared Redis backend is needed if you run more than one
# web process.
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_ENABLED=true

# ── AI providers (optional) ─────────────────────────────────────────────────
# Leave the keys empty and the AI module falls back to local, rule-based
# behaviour. Groq is the cheapest hosted option.
AI_MODE=local
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Internal service-to-service key. When set, AI JSON endpoints also accept it
# via the X-API-Key header as a CSRF alternative.
INTERNAL_API_KEY=

# ── Monitoring (optional) ───────────────────────────────────────────────────
# Leave SENTRY_DSN empty to disable error reporting.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ── Currency (optional) ─────────────────────────────────────────────────────
# The free fallback providers are used when no key is set.
CURRENCY_API_PROVIDER=exchangerate-api
CURRENCY_API_KEY=
DEFAULT_CURRENCY=AED

# ── Company details (optional - shown in the UI and on documents) ───────────
COMPANY_NAME=Azad Smart Systems
COMPANY_NAME_AR=شركة أزاد للأنظمة الذكية
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_WEBSITE=https://azadsystems.com
COMPANY_TAX_NUMBER=
COMPANY_LOGO=img/azad_logo.png

# ── Multi-tenancy ───────────────────────────────────────────────────────────
# TENANT_STRICT makes unscoped access to a tenant-scoped table log a warning.
# Keep it on; it is what surfaced the multi-entity join leaks.
TENANT_STRICT=true

# ── Security ────────────────────────────────────────────────────────────────
# Comma-separated. In production set this to the real origin(s) - the default
# only allows the local development server.
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
WTF_CSRF_ENABLED=true
MAX_LOGIN_ATTEMPTS=5
LOGIN_BLOCK_DURATION_MINUTES=15
SESSION_HOURS=12
REMEMBER_DAYS=14
MAX_CONTENT_LENGTH_MB=16

# ── Uploads / limits ────────────────────────────────────────────────────────
ALLOWED_UPLOAD_EXTENSIONS=images,documents
